# Copy this file to .env and paste your Tiger Data connection string.
# Find it in the Tiger Cloud console: your service -> Connect.
DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/tsdb?sslmode=require
# Keep this key server-side. Never put it in frontend/.env or expose it to the browser.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
